{
  "expo": {
    "name": "Amazon Scout",
    "slug": "amazon-scout-app",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amazonscout.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Amazon Scout requires camera access to scan barcodes and ISBNs quickly on store shelves."
      }
    },
    "android": {
      "package": "com.amazonscout.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A202C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "./plugins/withAndroidQueries",
      [
        "expo-camera",
        {
          "cameraPermission": "Amazon Scout requires camera access to scan barcodes and ISBNs quickly on store shelves."
        }
      ],
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
